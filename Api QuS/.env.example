# Plantilla de configuración de entorno para Api QuS
# Copia este archivo a '.env' y reemplaza los placeholders con tus credenciales reales.

APP_NAME="Api QuS - Servicio Integrador SUNAT & INDECOPI"
APP_VERSION="1.0.0"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Credenciales OAuth 2.0 de INDECOPI (No versionar valores reales en el repositorio)
INDECOPI_TOKEN_URL="https://servicios.indecopi.gob.pe/appTodosServicioAutorizacion/oauth/token"
INDECOPI_BASE_API="https://servicios.indecopi.gob.pe/appDPCMAQLCApi"
INDECOPI_USERNAME="<TU_INDECOPI_USERNAME>"
INDECOPI_PASSWORD="<TU_INDECOPI_PASSWORD>"
INDECOPI_CLIENT_ID="<TU_INDECOPI_CLIENT_ID>"
INDECOPI_CLIENT_SECRET="<TU_INDECOPI_CLIENT_SECRET>"

# Configuración opcional de SUNAT
SUNAT_CONSULTA_URL="https://e-consultaruc.sunat.gob.pe/cl-ti-itmrconsruc/FrameCriterioBusquedaWeb.jsp"
SUNAT_ALIAS_URL="https://e-consultaruc.sunat.gob.pe/cl-ti-itmrconsruc/jcrS00Alias"
SUNAT_COOKIE=""

REQUEST_TIMEOUT=15
